# G8 Solar — Environment Variables (example)
# Copy to `.env.local` for local development. Do not commit live secrets.

# --- Lead form email delivery (primary) ---
# Get your access key at https://web3forms.com — do not commit the live key.
VITE_WEB3FORMS_ACCESS_KEY=

# --- Legacy lead-record fallback (optional) ---
# The public website renders without these values. Keep only while the existing
# fallback is needed, then replace it with a GitHub-controlled CRM integration.
VITE_BASE44_APP_ID=your_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app
VITE_BASE44_FUNCTIONS_VERSION=

# --- Google Ads conversion tracking ---
# Base gtag is loaded in index.html with AW-18175802692.
# Set these in production so analytics.js can fire the conversion action:
VITE_GOOGLE_ADS_ID=AW-18175802692
VITE_GOOGLE_ADS_CONVERSION_LABEL=gqsaCI7dr-ccEMT68tpD

# --- Optional: GA4 (future funnels; not required for Phase 2A) ---
VITE_GA4_MEASUREMENT_ID=
